# LLM API Configuration
# Support any OpenAI-compatible provider: OpenAI, Groq, Together AI, DeepSeek, Local Ollama, etc.

# Required: Your API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom base URL (leave blank or commented out for default OpenAI: https://api.openai.com/v1)
# Examples:
# For Groq: https://api.groq.com/openai/v1
# For Ollama (local): http://localhost:11434/v1
# For Together AI: https://api.together.xyz/v1
# For DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=

# Optional: Default model (defaults to gpt-4o-mini if not specified)
# Examples: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, deepseek-chat
DEFAULT_MODEL=gpt-4o-mini
